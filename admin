#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$script_dir"

if [[ -x "$script_dir/.venv/bin/python3" ]]; then
  exec "$script_dir/.venv/bin/python3" -m services.gists.admin "$@"
fi

if [[ -x "$script_dir/venv/bin/python3" ]]; then
  exec "$script_dir/venv/bin/python3" -m services.gists.admin "$@"
fi

exec python3 -m services.gists.admin "$@"
